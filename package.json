{
  "name": "orchestrator-router",
  "version": "4.0.0",
  "description": "Client side router for Web Components using URLPattern (or URI Templates)",
  "author": "Sebastiaan Deckers <sebdeckers83@gmail.com>",
  "contributors": [
    "Brett Zamir"
  ],
  "license": "ISC",
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "src/index.js",
  "exports": "./src/index.js",
  "repository": {
    "type": "git",
    "url": "git@github.com:brettz9/orchestrator-router.git"
  },
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "prepublishOnly": "npm run tsc && npm run tsc-prod && npm run attw",
    "attw": "attw --pack . --profile esm-only node16",
    "tsc": "tsc",
    "tsc-prod": "tsc -p tsconfig-prod.json",
    "lint": "eslint .",
    "open": "open http://127.0.0.1:8115/coverage/ && pnpm start",
    "start": "static -p 8115",
    "cypress:open": "cypress open --browser chrome",
    "cypress:run": "cypress run --browser chrome",
    "coveradge": "coveradge --introTemplate \"UI Coverage (Cypress)\" doc-includes/coverage-badge.svg",
    "check-coverage": "nyc report --check-coverage ",
    "test": "run-s -c cypress:run check-coverage coveradge"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@babel/core": "^8.0.6",
    "@babel/preset-env": "^8.0.6",
    "@cypress/code-coverage": "^4.0.3",
    "@cypress/webpack-preprocessor": "^8.0.0",
    "@node-static/node-static": "^0.10.0",
    "babel-loader": "^10.1.1",
    "babel-plugin-istanbul": "^8.0.0",
    "coveradge": "^0.9.0",
    "cypress": "^16.1.0",
    "eslint": "^10.11.0",
    "eslint-config-ash-nazg": "^43.2.2",
    "mocha-badge-generator": "^0.13.0",
    "npm-run-all": "^4.1.5",
    "nyc": "^18.0.0",
    "open-cli": "^9.0.0",
    "typescript": "^7.0.2"
  },
  "standard": {
    "ignore": [
      "dist"
    ],
    "env": {
      "browser": true
    }
  },
  "nyc": {
    "check-coverage": true,
    "all": true,
    "include": [
      "src/**/*.js"
    ],
    "exclude": [
      "src/index.js"
    ],
    "report-dir": "coverage",
    "reporter": [
      "text",
      "html",
      "lcov",
      "json-summary"
    ],
    "lines": 100,
    "statements": 100,
    "functions": 100,
    "branches": 100
  }
}
